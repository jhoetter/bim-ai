DATABASE_URL=postgresql+asyncpg://bimai:bimai@localhost:5545/bimai
REDIS_URL=redis://localhost:6392
S3_ENDPOINT=http://localhost:9120
S3_BUCKET=bimai-dev
PYTHONPATH=./app/bim_ai
# Design system: default | conservative  (or pass via: DESIGN_SYSTEM=conservative make dev)
VITE_DESIGN_SYSTEM=default
# Gemini API key — used by claude-skills/watch-yt so Claude can watch YouTube videos
GEMINI_API_KEY=your-gemini-api-key-here

# Optional reverse-BIM multimodal reader dispatch.
# Used by app/scripts/reverse_bim_openai_reader.py via reverse_bim.reader_dispatch_execute.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_READER_MODEL=gpt-4.1
OPENAI_READER_TIMEOUT_SECONDS=300
# Optional cap per assignment; leave empty to use all assignment images.
OPENAI_READER_MAX_IMAGES=
