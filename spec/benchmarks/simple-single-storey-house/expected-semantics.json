{
  "schemaVersion": "bim-ai.benchmark.expected-semantics.v1",
  "benchmarkId": "simple-single-storey-house",
  "sourceOfIntent": "spec/trackers/ui-mcp-parity-tracker.md#same-house-parity-benchmarks",
  "paths": {
    "mcpCli": {
      "status": "fixture-validated-live-dry-run-and-commit-capable",
      "bundle": "mcp-cli-command-bundle.json",
      "liveDryRun": {
        "status": "optional",
        "requires": ["BIM_AI_BASE_URL", "BIM_AI_MODEL_ID"],
        "surface": "POST /api/models/{model_id}/bundles",
        "mode": "dry_run"
      },
      "liveCommit": {
        "status": "explicit-opt-in",
        "requires": ["BIM_AI_BASE_URL", "BIM_AI_MODEL_ID", "--commit-live"],
        "surface": "POST /api/models/{model_id}/bundles",
        "mode": "commit",
        "mutatesTargetModel": true,
        "postCommitEvidence": [
          "GET /api/models/{model_id}/command-log?limit=5",
          "GET /api/models/{model_id}/snapshot"
        ]
      }
    },
    "ui": {
      "status": "traceability-only",
      "traceability": "ui-cmdk-traceability.json",
      "todo": "Add an executable UI/Cmd+K path and semantic diff against this fixture once M2 UI benchmark automation is in scope."
    }
  },
  "tolerances": {
    "countDelta": 0,
    "dimensionMm": 1,
    "areaM2": 0.05
  },
  "expected": {
    "levels": {
      "count": 1,
      "ids": ["ssh-lvl-ground"],
      "elevationsMm": { "ssh-lvl-ground": 0 }
    },
    "walls": {
      "total": 6,
      "exterior": 4,
      "interior": 2,
      "exteriorWallTypeIds": ["ssh-wt-exterior"],
      "interiorWallTypeIds": ["ssh-wt-interior"]
    },
    "rooms": {
      "count": 3,
      "names": ["Bedroom", "Kitchen", "Living / Dining"],
      "targetAreaM2": {
        "ssh-room-living": 48,
        "ssh-room-bedroom": 17.6,
        "ssh-room-kitchen": 14.4
      }
    },
    "openings": {
      "doors": 3,
      "windows": 3,
      "hosted": 6,
      "allHaveHost": true,
      "allHaveFamilyType": true
    },
    "floors": {
      "count": 1,
      "ids": ["ssh-floor-ground"],
      "roomBounded": true
    },
    "roofs": {
      "count": 1,
      "ids": ["ssh-roof-main"],
      "geometryModes": ["gable"]
    },
    "views": {
      "plan": 1,
      "threeD": 1,
      "ids": ["ssh-view-ground-plan", "ssh-view-3d"]
    },
    "sheets": {
      "count": 1,
      "ids": ["ssh-sheet-a101"],
      "minPlacedViews": 2
    },
    "schedules": {
      "count": 1,
      "ids": ["ssh-schedule-openings"],
      "categories": ["opening"]
    },
    "annotations": {
      "tags": 1,
      "dimensions": 2
    }
  },
  "evidenceExpectations": {
    "semanticSummary": true,
    "semanticDiff": true,
    "commandSurfaceUsage": {
      "mustInclude": [
        "createLevel",
        "createWallChain",
        "createFloor",
        "createRoof",
        "insertDoorOnWall",
        "insertWindowOnWall",
        "createRoomOutline",
        "saveViewpoint",
        "CreateSheet",
        "PlaceViewOnSheet",
        "create_schedule_view"
      ],
      "forbidden": ["restoreElement"]
    },
    "advisor": {
      "status": "placeholder-live-dry-run-or-committed-output",
      "committedEvidence": [
        "GET /api/models/{model_id}/validate",
        "POST /api/models/{model_id}/qa/advisor",
        "GET /api/models/{model_id}/evidence-package"
      ]
    },
    "liveCommit": {
      "status": "explicit-opt-in",
      "artifacts": [
        "live-dry-run-evidence.json",
        "live-commit-evidence.json",
        "command-log-summary.json",
        "snapshot-summary.json"
      ]
    },
    "committedEvidence": {
      "status": "explicit-opt-in",
      "advisorValidationContract": {
        "validationPassField": "validationPass",
        "advisorPassField": "advisorPass",
        "validationStatusField": "validationStatus",
        "advisorStatusField": "advisorStatus",
        "blockingErrorCountsField": "blockingErrorCounts",
        "warningCountsField": "warningCounts",
        "infoCountsField": "infoCounts",
        "sourceModelRevisionFields": ["modelId", "revision", "source.modelId", "source.revision"],
        "semanticSourceChecksField": "semanticSourceChecks",
        "semanticSourceChecksRequire": [
          "expected simple-house counts from committed snapshot or summary",
          "no contradictory committed snapshot or summary counts",
          "no missing expected ssh-* ids when semantic ids are exposed"
        ],
        "missingCaptureEvidenceKind": "missing-committed-live-artifact",
        "warningsAndInfoAreNonBlocking": true
      },
      "artifacts": [
        "committed-evidence.json",
        "advisor-validation.json",
        "visual-evidence.json",
        "export-evidence.json"
      ]
    },
    "screenshots": {
      "status": "server-side-substitute-when-committed-evidence-requested",
      "requiredViewIds": ["ssh-view-ground-plan", "ssh-view-3d"],
      "serverSideSubstitute": "GET /api/models/{model_id}/exports/sheet-print-raster.png?sheetId=ssh-sheet-a101",
      "todo": "Full confidence still requires browser-rendered nonblank plan and 3D screenshots for ssh-view-ground-plan and ssh-view-3d."
    },
    "exports": {
      "status": "artifact-or-manifest-check-when-committed-evidence-requested",
      "checks": [
        "GET /api/models/{model_id}/exports/gltf-manifest",
        "GET /api/models/{model_id}/exports/ifc-manifest",
        "GET /api/models/{model_id}/exports/sheet-preview.pdf?sheetId=ssh-sheet-a101"
      ],
      "todo": "Full M2/M3 exit should add IFC and glTF round-trip evidence for this house."
    }
  }
}
