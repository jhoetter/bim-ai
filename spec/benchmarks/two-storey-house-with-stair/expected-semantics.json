{
  "schemaVersion": "bim-ai.benchmark.expected-semantics.v1",
  "benchmarkId": "two-storey-house-with-stair",
  "sourceOfIntent": "spec/ui-mcp-parity-tracker.md#same-house-parity-benchmarks",
  "paths": {
