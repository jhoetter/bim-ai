        "surface": "POST /api/models/{model_id}/bundles",
        "mode": "dry_run"
      },
      "liveCommit": {
        "status": "explicit-opt-in-not-default",
        "requires": ["BIM_AI_BASE_URL", "BIM_AI_MODEL_ID", "--commit-live"],
        "surface": "POST /api/models/{model_id}/bundles",
        "mode": "commit",
        "mutatesTargetModel": true
      }
    },
    "ui": {
      "status": "validated-replay",
      "traceability": "ui-cmdk-traceability.json",
      "equivalence": "ui-equivalence.json",
      "todo": "Add browser-authored UI replay for exact two-storey stair inputs."
    }
  },
  "tolerances": {
    "countDelta": 0,
    "dimensionMm": 1,
    "areaM2": 0.05
  },
  "expected": {
