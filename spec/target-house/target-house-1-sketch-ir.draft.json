    "primaryView": "front-left axonometric with roof terrace visible",
    "style": "minimalist modern residential",
    "dominantVolumes": [
      {
        "id": "upper_white_wrapper_shell",
        "description": "Dominant thick white folded upper shell that reads as one architectural wrapper across side walls, roof plane, fascia, front frame, and roof cutout returns.",
        "priority": "critical"
      },
      {
        "id": "ground_clad_base",
        "description": "Smaller rectangular ground-floor base with continuous vertical cladding and visible portrait openings.",
        "priority": "critical"
      },
      {
        "id": "front_loggia_void",
        "description": "Deep recessed upper-front loggia behind a thick white frame with a three-bay facade and thin black guard rail.",
        "priority": "critical"
      },
      {
        "id": "roof_court_void",
        "description": "Large open-to-sky terrace void cut into the right/back roof plane with flat occupied floor, white returns, glass guard, and access glazing.",
        "priority": "critical"
      }
    ],
    "nonNegotiables": [
      "white roof and walls form a single folded wrapper, not a dark pitched roof on a box",
      "roof terrace cutout must render as a real occupied void in normal 3D views",
      "front upper loggia must be recessed behind thick side and roof returns",
      "upper wrapper dominates and overhangs the smaller ground-floor clad base",
      "vertical board-and-batten cladding must be legible on the ground-floor base and central loggia pier",
      "rooms, stairs, doors, and slab openings must be usable enough for project initiation"
    ],
    "forbiddenOutcomes": [
      "generic rectangular house with a normal gable roof",
      "roof opening present only as metadata or only visible in plan",
      "flat balcony attached to the front instead of a recessed loggia",
      "final envelope relying on translucent mass placeholders",
      "room-separation geometry hiding open or inaccessible rooms",
      "dark or brown roof material"
    ]
  },
