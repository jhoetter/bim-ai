{
  "schemaVersion": "sketch-to-bim-golden-suite.v0",
  "description": "Preflight golden cases for sketch-to-BIM project initiation. Live baselines are planned here and captured only after a model is intentionally generated.",
  "liveGoldenDefaults": {
    "status": "planned",
    "baselinePolicy": "Do not create seed artifacts during golden preflight. After an approved live run, capture current-head screenshot, Advisor, evidence, export-validation, and tolerance-ledger baselines beside the run evidence.",
    "requiredArtifacts": [
      "live-runner-manifest.json",
      "tool-run-summary.json",
      "snapshot.json",
      "validate.json",
      "evidence-package.json",
      "advisor-warning.json",
      "advisor-info.json",
      "visual-evidence-contract.json",
      "screenshot-manifest.json",
      "visual-gate.json",
      "export-validation.json",
      "tolerance-ledger.json"
    ],
    "acceptance": {
      "requireCurrentHead": true,
      "requireAdvisorBaseline": true,
      "requireVisualBaseline": true,
      "requireExchangeValidation": true,
      "requireToleranceLedger": true
    }
  },
  "cases": [
    {
      "id": "target-house-project-initiation",
      "ir": "spec/examples/sketch-understanding-ir.example.json",
      "capabilities": "spec/sketch-to-bim-capability-matrix.json",
      "seedDslRecipe": "spec/examples/seed-dsl-modern-house.example.json",
      "liveGolden": {
        "status": "planned"
      },
      "expected": {
        "maxCoverageErrors": 0,
        "maxBlockedFeatures": 0
      }
    },
    {
      "id": "two-volume-massing",
      "ir": "spec/examples/sketch-understanding-ir-massing.example.json",
      "capabilities": "spec/sketch-to-bim-capability-matrix.json",
      "liveGolden": {
        "status": "planned",
        "acceptance": {
          "requireCurrentHead": true,
          "requireAdvisorBaseline": true,
          "requireVisualBaseline": true,
          "requireExchangeValidation": false,
          "requireToleranceLedger": true
        }
      },
      "expected": {
        "maxCoverageErrors": 0,
        "maxBlockedFeatures": 0
      }
    },
    {
      "id": "documentation-ready-house",
      "ir": "spec/examples/sketch-understanding-ir-documentation.example.json",
      "capabilities": "spec/sketch-to-bim-capability-matrix.json",
      "seedDslRecipe": "spec/examples/seed-dsl-modern-house.example.json",
      "liveGolden": {
        "status": "planned"
      },
      "expected": {
        "maxCoverageErrors": 0,
        "maxBlockedFeatures": 0
      }
    }
  ]
}
