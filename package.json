{
  "name": "bim-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "bim-ai — browser-first BIM coordination (Vite + Python).",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:root": "eslint \"packages/**/*.{ts,tsx}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,yml,yaml}\"",
    "architecture": "node scripts/check-architecture.mjs",
    "contract:parity": "node scripts/check-contract-parity.mjs",
    "quality:waivers": "node scripts/check-quality-waivers.mjs",
    "quality:report": "node scripts/code-quality-report.mjs",
    "maintainability:budgets": "node scripts/check-maintainability-budgets.mjs",
    "js-lint:budget": "node scripts/check-js-lint-budget.mjs",
    "ui:quality-budgets": "node scripts/check-ui-quality-budgets.mjs",
    "security:hygiene": "node scripts/check-security-hygiene.mjs",
    "test-env:policy": "node scripts/check-frontend-test-environments.mjs",
    "test:e2e:real-backend": "pnpm --filter @bim-ai/web test:e2e:real-backend",
    "audit:ui-mcp-parity": "node scripts/audit-ui-mcp-parity.mjs --out spec/generated/ui-mcp-parity.json",
    "benchmark:simple-house": "node scripts/benchmarks/simple-house.mjs",
    "verify:m2-parity": "node scripts/verify-m2-parity.mjs",
    "verify:m3-parity": "node scripts/verify-m3-parity.mjs",
    "verify:m4-parity": "node scripts/verify-m4-parity.mjs",
    "verify": "pnpm format:check && pnpm quality:waivers && pnpm architecture && pnpm test",
    "verify:strict": "pnpm format:check && pnpm quality:waivers && pnpm maintainability:budgets && pnpm js-lint:budget && pnpm security:hygiene && pnpm test-env:policy && pnpm architecture && pnpm contract:parity && pnpm typecheck && pnpm test && pnpm build && pnpm ui:quality-budgets",
    "build:dist": "pnpm --filter @bim-ai/hofos-ui build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "eslint-plugin-bim-ai": "workspace:*",
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.3",
    "turbo": "^2.9.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
